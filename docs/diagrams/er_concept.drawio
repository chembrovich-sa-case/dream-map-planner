              <mxPoint x="430" y="420" />
              <mxPoint x="430" y="543" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Связь 5: users -> balance_snapshots (1 : N) -->
        <mxCell id="rel_user_snapshot" value="1 : N&lt;br/&gt;&lt;span style=&quot;font-size:10px;color:#64748B;&quot;&gt;история баланса&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0369A1;strokeWidth=2;fontFamily=Helvetica;fontSize=11;fontColor=#0369A1;fontStyle=1;startArrow=ERone;endArrow=ERmany;exitX=0.75;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ent_user" target="ent_snapshot">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="278" y="90" />
              <mxPoint x="1120" y="90" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Связь 6: balance_snapshots -> balance_snapshot_items (1 : N) -->
        <mxCell id="rel_snapshot_item" value="1 : N&lt;br/&gt;&lt;span style=&quot;font-size:10px;color:#64748B;&quot;&gt;содержит баллы&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0E7490;strokeWidth=2;fontFamily=Helvetica;fontSize=11;fontColor=#0E7490;fontStyle=1;startArrow=ERone;endArrow=ERmany;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ent_snapshot" target="ent_snapshot_item">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Связь 7: life_spheres -> balance_snapshot_items (1 : N, срез по сфере) -->
        <mxCell id="rel_sphere_snapshot_item" value="1 : N&lt;br/&gt;&lt;span style=&quot;font-size:10px;color:#64748B;&quot;&gt;фиксация балла сферы&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0F766E;strokeWidth=1.5;dashed=1;fontFamily=Helvetica;fontSize=11;fontColor=#0F766E;fontStyle=1;startArrow=ERone;endArrow=ERmany;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ent_sphere" target="ent_snapshot_item">
          <mxGeometry relative="1" as="geometry" />
