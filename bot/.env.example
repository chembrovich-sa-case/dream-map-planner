# ============================================================================
# Переменные окружения Telegram-бота «Горизонт»
# ============================================================================

# Токен бота, полученный у официального отца ботов @BotFather
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Базовый адрес FastAPI бэкенда «Горизонт»
API_BASE_URL=http://127.0.0.1:8000/api

# Таймаут запросов к бэкенду (в секундах)
REQUEST_TIMEOUT=8.0
